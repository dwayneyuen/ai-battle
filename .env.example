# Copy to .env and fill in only the providers you want to use.
# The demo runs with mock agents and needs NONE of these.

# --- Free / low-cost options (recommended to start) ---
# Google Gemini has a genuinely free tier: https://aistudio.google.com
GOOGLE_API_KEY=
# Groq: fast, generous free tier: https://console.groq.com
GROQ_API_KEY=
# OpenRouter: one key, many models (several free): https://openrouter.ai
OPENROUTER_API_KEY=
# Ollama runs locally for $0 and needs no key — just `ollama serve`.
# Optionally override its host:
# OLLAMA_HOST=http://localhost:11434/v1

# --- Paid (use small models like gpt-5-mini / claude-haiku to keep it cheap) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

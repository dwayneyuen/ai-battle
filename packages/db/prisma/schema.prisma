// AI Battle data model. This schema is the SINGLE source of truth for the
// database — every read and write in the whole app goes through the Prisma
// client generated from it (see ../src/index.ts). No hand-written SQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A competitor: one model behind a `provider:model` spec.
model Model {
  id            String         @id @default(cuid())
  provider      String // "openrouter", "openai", ...
  spec          String         @unique // full spec, e.g. "openrouter:openai/gpt-5"
  label         String // display name shown on the site
  createdAt     DateTime       @default(now())
  ratings       Rating[]
  seats         MatchPlayer[]
  pdMatchesA    PdMatch[]      @relation("PdMatchA")
  pdMatchesB    PdMatch[]      @relation("PdMatchB")
  pdReflections PdReflection[]
}

/// A model's standing in one game (we ship "mafia" first).
model Rating {
  id        String   @id @default(cuid())
  model     Model    @relation(fields: [modelId], references: [id], onDelete: Cascade)
  modelId   String
  game      String // "mafia"
  elo       Int      @default(1000)
  games     Int      @default(0)
  wins      Int      @default(0)
  losses    Int      @default(0)
  forfeits  Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([modelId, game])
}

/// A single played match.
model Match {
  id         String        @id @default(cuid())
  game       String // "mafia"
  seed       String? // stored as text to avoid BigInt JSON friction
  status     String        @default("completed") // "completed" | "void"
  winner     String? // "town" | "mafia"
  reason     String?
  config     Json?
  startedAt  DateTime      @default(now())
  finishedAt DateTime?
  players    MatchPlayer[]
  events     MatchEvent[]
}

/// One seat in a match, linking a model to its role and outcome.
model MatchPlayer {
  id        String  @id @default(cuid())
  match     Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchId   String
  model     Model   @relation(fields: [modelId], references: [id])
  modelId   String
  seatId    String // "p1"
  seatName  String // "Alice"
  role      String // "mafia" | "doctor" | "detective" | "villager"
  alive     Boolean @default(true)
  forfeited Boolean @default(false)
  won       Boolean @default(false)

  @@index([matchId])
  @@index([modelId])
}

/// One event in the transcript — the data a replay steps through.
model MatchEvent {
  id           String   @id @default(cuid())
  match        Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchId      String
  idx          Int // order within the match
  type         String
  message      String
  actorSeatId  String?
  targetSeatId String?
  day          Int
  phase        String
  data         Json?
  visibleTo    String[] // seat ids; empty = public

  @@index([matchId, idx])
}

// --- Prisoner's Dilemma "season" -------------------------------------------
// A season studies how models reason over time: they declare a strategy, play a
// round robin against every other model, reflect on their OWN results, and revise
// — across several generations. Reasoning is captured at three levels (per round,
// per match, per generation) so the evolution of each model's thinking is replayable.

/// A full Prisoner's Dilemma season: an ordered sequence of round-robin generations.
model PdSeason {
  id          String         @id @default(cuid())
  config      Json? // rounds, payoff, field of specs, etc.
  status      String         @default("completed") // "completed" | "void"
  createdAt   DateTime       @default(now())
  finishedAt  DateTime?
  generations PdGeneration[]
  matches     PdMatch[]
  reflections PdReflection[]
}

/// One round robin within a season. After it, each model reflects and revises.
model PdGeneration {
  id          String         @id @default(cuid())
  season      PdSeason       @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  seasonId    String
  idx         Int // 0-based generation index
  standings   Json? // snapshot of running totals after this generation
  createdAt   DateTime       @default(now())
  matches     PdMatch[]
  reflections PdReflection[]

  @@index([seasonId])
}

/// One head-to-head match (a fixed number of rounds) within a generation.
model PdMatch {
  id           String         @id @default(cuid())
  season       PdSeason       @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  seasonId     String
  generation   PdGeneration   @relation(fields: [generationId], references: [id], onDelete: Cascade)
  generationId String
  aModel       Model          @relation("PdMatchA", fields: [aModelId], references: [id])
  aModelId     String
  bModel       Model          @relation("PdMatchB", fields: [bModelId], references: [id])
  bModelId     String
  seed         String?
  scoreA       Int
  scoreB       Int
  rounds       PdRound[]
  reflections  PdReflection[]

  @@index([seasonId])
  @@index([generationId])
}

/// One round within a match: both moves, scores, and each side's private thoughts.
model PdRound {
  id        String  @id @default(cuid())
  match     PdMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchId   String
  idx       Int
  moveA     String // "C" | "D"
  moveB     String // "C" | "D"
  scoreA    Int
  scoreB    Int
  thoughtsA String? // seat A's per-round reasoning
  thoughtsB String? // seat B's per-round reasoning

  @@index([matchId, idx])
}

/// A captured reflection at one of three levels: "initial", "match", "generation".
model PdReflection {
  id           String        @id @default(cuid())
  model        Model         @relation(fields: [modelId], references: [id])
  modelId      String
  level        String // "initial" | "match" | "generation"
  season       PdSeason      @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  seasonId     String
  generation   PdGeneration? @relation(fields: [generationId], references: [id], onDelete: Cascade)
  generationId String?
  match        PdMatch?      @relation(fields: [matchId], references: [id], onDelete: Cascade)
  matchId      String?
  strategy     String? // declared strategy (initial / generation levels)
  notebook     String? // notebook snapshot (generation level)
  thoughts     String? // the reflection content
  createdAt    DateTime      @default(now())

  @@index([seasonId])
  @@index([modelId])
}
